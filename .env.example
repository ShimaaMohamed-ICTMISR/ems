# Voting Service API (local)
# Copy this file to .env.local and fill in your values.
# Do not commit .env or .env.local to Git.

# Opportunity Management — required for /dashboard/opportunities (do NOT reuse VITE_API_BASE_URL from other services)
# VITE_OPPORTUNITY_API_BASE_URL=https://ems-opportunity-management-service.onrender.com/api/v1
# Optional: NEXT_PUBLIC_OPPORTUNITY_API_BASE_URL=... (same value; Vite exposes NEXT_PUBLIC_*)

VITE_API_BASE_URL=http://localhost:3001
VITE_SERVICE_TICKET=your-service-ticket-here
VITE_TEST_USER_ID=your-test-user-id-here

# Required for tenant isolation (sent as X-Tenant-Id on opportunity service requests)
# VITE_TENANT_ID=your-tenant-uuid

# Opportunity: every request sends X-Service-Ticket (never commit real values)
# VITE_OPPORTUNITY_SERVICE_TICKET=your-ticket-here
# If unset: VITE_SERVICE_TICKET or VITE_SERVICE_TICKET_KEY

# HR service direct base URL (skip localhost proxy in dev)
# VITE_HR_API_BASE_URL=https://ems-human-resources-management-service.onrender.com/api/hr
# VITE_HR_SERVICE_TICKET=your-hr-ticket-here
